<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.userswitch"
    android:versionCode="9"
    android:versionName="0.9">

    <!-- Shizuku client: permission and V3 marker come from the Shizuku provider library. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Window.setHideOverlayWindows (Hardening) -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <!-- GrapheneOS detection (Hardening.isGrapheneOs) -->
        <package android:name="app.grapheneos.apps" />
        <package android:name="app.grapheneos.info" />
    </queries>

    <!-- memtagMode: sync memory tagging where the hardware and system offer it
         (GrapheneOS, Pixel 8+ with MTE on); ignored elsewhere. -->
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.UserSwitch"
        android:memtagMode="sync"
        android:allowBackup="false">

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <!-- Folding and unfolding resize the window: MainActivity relays itself out
             (one or two panes) instead of being recreated. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported so the shell daemon can reach it; ConfigProvider.call()
             rejects every caller except the shell (or root) uid. -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="dev.userswitch.config"
            android:exported="true" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ShizukuWatch"
            android:exported="false" />

        <!-- Shizuku sends its binder here. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="dev.userswitch.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
