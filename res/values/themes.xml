<?xml version="1.0" encoding="utf-8"?>
<resources>
    <bool name="light_bars">true</bool>

    <!-- Framework-only Material 3: DeviceDefault (Material You dialogs and controls on
         Android 12+) with our color roles; MainActivity draws the M3 components. -->
    <style name="Theme.UserSwitch" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- true: the system adds a scrim behind 3-button navigation only (gesture
             navigation stays clear); without it the buttons drew over the text. -->
        <item name="android:enforceNavigationBarContrast">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
